# Production Environment Variables for Frontend
# These values are baked into the build — they must be present at build time.
# Copy this file to .env.production and fill in real values before deploying.
# DO NOT commit .env.production with real secrets to Git!

# Backend API base URL (must end with /api)
# Example: https://luxury-backend-xxx.amvera.io/api
NEXT_PUBLIC_API_URL=https://vront-gostsi.amvera.io/api

# Storage encryption key for localStorage PII (32+ chars recommended)
# Generate with: openssl rand -hex 16
NEXT_PUBLIC_STORAGE_KEY=CHANGE_ME_TO_A_STRONG_KEY
